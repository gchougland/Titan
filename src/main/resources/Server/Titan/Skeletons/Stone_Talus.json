{
  "$Comment": "Stone Talus rig. Offsets are model units (one prefab block) in titan-local space: +X right, +Y up, -Z forward. The root entity sits on the ground, so Body's offset is the hip height.",
  "ClipSet": "Stone_Talus",
  "BodyBone": "Body",
  "UnitScale": 1.0,
  "HipHeight": 5.0,
  "AnimationPositionScale": 1.0,
  "ColliderConfig": "Titan_Platform",

  "Bones": [
    {
      "Name": "Body",
      "Offset": { "X": 0, "Y": 5.0, "Z": 0 },
      "Detachable": false
    },
    {
      "$Comment": "The body slab is authored 4 deep x 4 tall x 9 long, so it is yawed 90 degrees to put its long axis across the shoulders. Pivot is the centre of the slab.",
      "Name": "Body_Mesh",
      "Parent": "Body",
      "Offset": { "X": 0, "Y": 0, "Z": 0 },
      "Rotation": { "X": 0, "Y": 90, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Body",
      "Pivot": { "X": 1.0, "Y": 2.0, "Z": 0.5 },
      "Scale": 1.0,
      "ColliderStride": 3
    },

    {
      "Name": "Arm_L_Upper",
      "Parent": "Body",
      "Offset": { "X": -4.0, "Y": 1.3, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Arm_Segment",
      "Pivot": { "X": 1.0, "Y": 3.0, "Z": 1.0 },
      "Scale": 1.667,
      "ColliderStride": 2
    },
    {
      "Name": "Arm_L_Lower",
      "Parent": "Arm_L_Upper",
      "Offset": { "X": 0, "Y": -5.0, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Arm_Segment",
      "Pivot": { "X": 1.0, "Y": 3.0, "Z": 1.0 },
      "Scale": 1.5,
      "ColliderStride": 2
    },
    {
      "$Comment": "Pivot is the middle of the fist rather than the wrist, because the smash drives this bone's pivot to the impact point and a fist centred there reads as embedded in the ground.",
      "Name": "Hand_L",
      "Parent": "Arm_L_Lower",
      "Offset": { "X": 0, "Y": -4.5, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Hand",
      "Pivot": { "X": 1.0, "Y": 1.0, "Z": 1.0 },
      "Scale": 1.8,
      "ColliderStride": 1
    },

    {
      "Name": "Arm_R_Upper",
      "Parent": "Body",
      "Offset": { "X": 4.0, "Y": 1.3, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Arm_Segment",
      "Pivot": { "X": 1.0, "Y": 3.0, "Z": 1.0 },
      "Scale": 1.667,
      "ColliderStride": 2
    },
    {
      "Name": "Arm_R_Lower",
      "Parent": "Arm_R_Upper",
      "Offset": { "X": 0, "Y": -5.0, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Arm_Segment",
      "Pivot": { "X": 1.0, "Y": 3.0, "Z": 1.0 },
      "Scale": 1.5,
      "ColliderStride": 2
    },
    {
      "Name": "Hand_R",
      "Parent": "Arm_R_Lower",
      "Offset": { "X": 0, "Y": -4.5, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Hand",
      "Pivot": { "X": 1.0, "Y": 1.0, "Z": 1.0 },
      "Scale": 1.8,
      "ColliderStride": 1
    },

    {
      "$Comment": "Legs carry no colliders: they swing fastest and a player anchored to one would be flung around.",
      "Name": "Leg_L_Upper",
      "Parent": "Body",
      "Offset": { "X": -2.2, "Y": -2.0, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Leg_Segment",
      "Pivot": { "X": 1.0, "Y": 2.0, "Z": 1.0 },
      "Scale": 0.9
    },
    {
      "Name": "Leg_L_Lower",
      "Parent": "Leg_L_Upper",
      "Offset": { "X": 0, "Y": -1.8, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Leg_Segment",
      "Pivot": { "X": 1.0, "Y": 2.0, "Z": 1.0 },
      "Scale": 0.9
    },
    {
      "Name": "Foot_L",
      "Parent": "Leg_L_Lower",
      "Offset": { "X": 0, "Y": -1.8, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Foot",
      "Pivot": { "X": 1.0, "Y": 0.0, "Z": 1.0 },
      "Scale": 1.6
    },

    {
      "Name": "Leg_R_Upper",
      "Parent": "Body",
      "Offset": { "X": 2.2, "Y": -2.0, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Leg_Segment",
      "Pivot": { "X": 1.0, "Y": 2.0, "Z": 1.0 },
      "Scale": 0.9
    },
    {
      "Name": "Leg_R_Lower",
      "Parent": "Leg_R_Upper",
      "Offset": { "X": 0, "Y": -1.8, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Leg_Segment",
      "Pivot": { "X": 1.0, "Y": 2.0, "Z": 1.0 },
      "Scale": 0.9
    },
    {
      "Name": "Foot_R",
      "Parent": "Leg_R_Lower",
      "Offset": { "X": 0, "Y": -1.8, "Z": 0 },
      "Prefab": "Titan/Talus/Talus_Foot",
      "Pivot": { "X": 1.0, "Y": 0.0, "Z": 1.0 },
      "Scale": 1.6
    }
  ],

  "IkChains": [
    {
      "$Comment": "RestOffset is measured from the Body bone, which sits HipHeight above the ground, so Y is the drop back down to the feet.",
      "Name": "Leg_L",
      "Kind": "TwoBone",
      "Role": "Foot",
      "Bones": [ "Leg_L_Upper", "Leg_L_Lower", "Foot_L" ],
      "PoleDirection": { "X": 0, "Y": 0, "Z": -1 },
      "Side": -1,
      "StrideLength": 3.5,
      "StepHeight": 1.6,
      "GaitPhase": 0.0,
      "RestOffset": { "X": -2.2, "Y": -5.0, "Z": 0 }
    },
    {
      "Name": "Leg_R",
      "Kind": "TwoBone",
      "Role": "Foot",
      "Bones": [ "Leg_R_Upper", "Leg_R_Lower", "Foot_R" ],
      "PoleDirection": { "X": 0, "Y": 0, "Z": -1 },
      "Side": 1,
      "StrideLength": 3.5,
      "StepHeight": 1.6,
      "GaitPhase": 0.5,
      "RestOffset": { "X": 2.2, "Y": -5.0, "Z": 0 }
    },
    {
      "Name": "Arm_L",
      "Kind": "TwoBone",
      "Role": "Hand",
      "Bones": [ "Arm_L_Upper", "Arm_L_Lower", "Hand_L" ],
      "PoleDirection": { "X": 0, "Y": 0, "Z": 1 },
      "Side": -1,
      "RestOffset": { "X": -4.5, "Y": -4.0, "Z": -2.0 }
    },
    {
      "Name": "Arm_R",
      "Kind": "TwoBone",
      "Role": "Hand",
      "Bones": [ "Arm_R_Upper", "Arm_R_Lower", "Hand_R" ],
      "PoleDirection": { "X": 0, "Y": 0, "Z": 1 },
      "Side": 1,
      "RestOffset": { "X": 4.5, "Y": -4.0, "Z": -2.0 }
    }
  ],

  "WeakpointSockets": [
    { "Bone": "Body", "Offset": { "X": 0.0, "Y": 2.4, "Z": 0.6 } },
    { "Bone": "Body", "Offset": { "X": -2.8, "Y": 2.2, "Z": -0.2 } },
    { "Bone": "Body", "Offset": { "X": 2.8, "Y": 2.2, "Z": -0.2 } },
    { "Bone": "Body", "Offset": { "X": -1.5, "Y": 2.3, "Z": 1.3 } },
    { "Bone": "Body", "Offset": { "X": 1.5, "Y": 2.3, "Z": 1.3 } },
    { "Bone": "Body", "Offset": { "X": 0.0, "Y": 2.2, "Z": -1.4 } }
  ]
}
