commands.titan.root.desc=Titan commands (/ti)
commands.titan.noneNearby=No titan found nearby.
commands.titan.unknownVariant=Unknown titan variant "{variant}". Known variants: {known}

commands.titan.spawn.desc=Spawn a titan
commands.titan.spawn.variant.desc=The titan variant id, e.g. Stone_Talus_Iron
commands.titan.spawn.position.desc=Where to spawn it; defaults to a spot ahead of you
commands.titan.spawn.yaw.desc=Facing in degrees; defaults to your own facing
commands.titan.spawn.colliders.desc=Which parts are solid: none, top (default) or all
commands.titan.spawn.success=Spawned {variant} at ({x, number}, {y, number}, {z, number}) with {parts, number} parts, {weakpoints, number} ore nodes and {colliders} collision.
commands.titan.spawn.failed=Could not spawn titan: {error}
commands.titan.spawn.badColliders=Unknown collider mode '{value}'. Expected one of: {known}

commands.titan.kill.desc=Kill nearby titans
commands.titan.kill.radius.desc=Search radius in blocks
commands.titan.kill.instant.desc=Delete outright instead of playing the fall-apart death
commands.titan.kill.result=Killed {count, plural, one {1 titan} other {{count, number} titans}}.

commands.titan.list.desc=List nearby titans and known variants
commands.titan.list.radius.desc=Search radius in blocks
commands.titan.list.variants=Known variants: {variants}
commands.titan.list.entry={variant} - {state}, clip {clip}, {weakpoints, number}/{total, number} ore nodes ({toKill, number} to kill), {distance, number} blocks away
commands.titan.list.count={count, plural, one {1 titan} other {{count, number} titans}} nearby.

commands.titan.sites.desc=Show the natural spawn sites around you and why each is or is not occupied
commands.titan.sites.cells.desc=How many grid cells to check in each direction
commands.titan.sites.variant.desc=Only list cells holding this variant, e.g. Roaming_Temple
commands.titan.sites.entry=({x, number}, {z, number}) {distance, number} blocks - {status}, {environment}, {variant}
commands.titan.sites.count={cells, number} cells of {size, number} blocks checked. {sited, number} hold a titan, {ready, number} of those can be built right now.
commands.titan.sites.filtered={cells, number} cells of {size, number} blocks checked. {sited, plural, one {1 holds} other {{sited, number} hold}} {variant}, {ready, number} of those can be built right now.
commands.titan.sites.unreadable={unreadable, number} of those cells could not be read because their chunks are not loaded, so this is not the whole picture. Walk closer, or raise --cells to sweep further once they load.

commands.titan.anim.desc=Play an animation clip on the nearest titan
commands.titan.anim.clip.desc=Clip name from the skeleton's clip set, e.g. Walk
commands.titan.anim.state.desc=Also switch the titan to this state
commands.titan.anim.radius.desc=Search radius in blocks
commands.titan.anim.playing=Playing {clip} ({duration, number}s) on a titan in state {state}.
commands.titan.anim.unknownClip=Unknown clip "{clip}". Known clips: {known}

commands.titan.dance.desc=Make the nearest titan perform a player emote
commands.titan.dance.radius.desc=Search radius in blocks
commands.titan.dance.playing=Dancing. The player emote drives {bones, number} of the titan's {total, number} bones over {duration, number}s.
commands.titan.dance.unavailable=The {skeleton} clip set has no Dance entry.

commands.titan.debug.desc=Inspect the nearest titan's rig
commands.titan.debug.mode.desc=BONES, IK, COLLIDERS or STATE
commands.titan.debug.particle.desc=Particle system to draw gizmos with
commands.titan.debug.radius.desc=Search radius in blocks
commands.titan.debug.bone={bone} at ({x, number}, {y, number}, {z, number})
commands.titan.debug.foot=foot {chain}: stepping={stepping} progress={progress, number} at ({x, number}, {y, number}, {z, number})
commands.titan.debug.hand=hand {chain}: weight={weight, number} goal ({x, number}, {y, number}, {z, number})
commands.titan.debug.colliders={parts, number} parts, {colliders, number} of them climbable.
commands.titan.debug.state={variant}: {state} for {stateTime, number}s, clip {clip}, yaw {yaw, number}, attack cooldown {cooldown, number}s, next arm {side}, {weakpoints, number}/{total, number} ore nodes ({toKill, number} to kill)

commands.titan.perf.desc=Report how much of last tick titan parts spent on network updates
commands.titan.perf.idle=No titan parts ticked last tick, so there is nothing to report.
commands.titan.perf.volume=Sent {written, number} of {considered, number} part transforms last tick: {kib, number} KiB per tick, {kibs, number} KiB/s per viewer before compression.
commands.titan.perf.skipped=Skipped {skipped, number}: {pose, number} titan not posing, {bone, number} bone still, {deadband, number} inside deadband, {phase, number} awaiting their turn.
commands.titan.perf.tuning=Tolerances: {epsilon, number} blocks, {rotation, number} degrees, {interval, number}s between updates. Run /entity tracker on yourself for what your client is actually being sent.

commands.titan.preview.desc=Stand a titan prefab up as a hologram to see whether one entity could replace its voxels
commands.titan.preview.prefab.desc=Prefab key, e.g. Temple_Body
commands.titan.preview.yaw.desc=Facing in degrees; defaults to your own facing. Spawn two at different yaws to see whether the mesh turns
commands.titan.preview.layers.desc=Show only this many layers from the bottom up
commands.titan.preview.unknownPrefab=No prefab found for "{prefab}".
commands.titan.preview.spawned=Preview of {prefab} at {yaw, number} degrees, {distance, number} blocks ahead. Does the mesh face where you asked, and is it solid or a ghost? Remove it with /prefabpreview remove --radius=64.
